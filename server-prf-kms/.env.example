# Server Configuration
PORT=1337
NODE_ENV=production

# AWS Configuration
AWS_REGION=us-east-1
# Use IAM role when deployed on EC2/ECS/Lambda
# Or provide explicit credentials for local testing:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# KMS Configuration
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
KMS_MASTER_SECRET_NAME=nuri-master-secret

# Local Development/Testing
# Set to true to use local simulation (no AWS required)
KMS_SIMULATION=false
# Required for simulation mode:
NURI_MASTER_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa